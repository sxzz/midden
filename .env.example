# At least 32 random characters, e.g. `openssl rand -base64 48`. Encrypts
# stored account credentials and signs media links: keep it, and back it up.
SECRET_KEY=

# Telegram bot and its owner, the only user allowed in.
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=

# Public HTTPS address of the web app, ending in /app/.
WEB_APP_URL=

# Optional.
# DATA_PATH=./data
# PORT=8080
# LOG_LEVEL=info

# Media originals in Cloudflare R2 (docs/operations.md). Without these,
# media stays in the data directory only.
# MEDIA_STORE=r2
# R2_ACCOUNT_ID=
# R2_BUCKET=midden
# MEDIA_PUBLIC_URL=https://midden-media.sxzz.moe
# One account API token: R2 object read and write on midden and
# midden-backup, Cache Purge on the media domain's zone, Account Analytics
# read. R2's S3 keys derive from it; with MEDIA_STORE=r2 the server does not
# start without it.
# CF_API_TOKEN=
# The zone of MEDIA_PUBLIC_URL; deleted media are purged from its cache.
# CF_ZONE_ID=

# Raw upstream responses in a private R2 bucket (docs/operations.md), never
# the public media bucket; without it they stay in the database. Its S3 keys
# derive from CF_API_TOKEN (with R2_ACCOUNT_ID).
# RAW_R2_BUCKET=midden-backup

# Copy the database to the R2 bucket midden-backup with Litestream
# (litestream.yml, docs/operations.md). Litestream cannot derive keys from
# CF_API_TOKEN, so it has its own S3 key pair.
# COMPOSE_PROFILES=litestream
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=
