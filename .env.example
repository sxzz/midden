# Use URL-safe random passwords (or percent-encode them in DATABASE_URL).
POSTGRES_PASSWORD=replace-with-random-admin-password
APP_DB_PASSWORD=replace-with-random-runtime-password
ADAPTER_TOKEN=replace-with-random-service-token
S3_ENDPOINT=https://your-s3-endpoint.example
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_BUCKET=monitor

# Optional: base64-encoded 32-byte encryption key, only needed for personal accounts.
# CREDENTIAL_KEY=

# Optional Telegram process; must match telegram_channel_id in core config.
TELEGRAM_CHANNEL_ID=
