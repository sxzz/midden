{
  "name": "@midden/server",
  "type": "module",
  "private": true,
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    "./api": "./src/http/app.ts"
  },
  "files": [
    "drizzle",
    "src"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/main.ts",
    "start": "node src/main.ts",
    "typecheck": "tsrs --fast",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "cli": "node --env-file-if-exists=../.env src/cli.ts"
  },
  "dependencies": {
    "@fxembed/atmosphere": "workspace:*",
    "@hono/node-server": "^2.1.11",
    "@hono/standard-validator": "^0.4.1",
    "@midden/shared": "workspace:*",
    "@simplewebauthn/server": "^14.1.0",
    "@standard-schema/spec": "^1.1.0",
    "drizzle-orm": "^1.0.0-rc.6",
    "grammy": "^1.48.0",
    "hono": "^4.13.21",
    "pino": "^10.4.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "drizzle-kit": "^1.0.0-rc.6",
    "vitest": "^5.1.1"
  }
}
