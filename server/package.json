{
  "name": "@midden/server",
  "type": "module",
  "private": true,
  "imports": {
    "#*": "./src/*"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/main.ts",
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "cli": "node --env-file-if-exists=../.env src/cli.ts"
  },
  "dependencies": {
    "@fxembed/atmosphere": "workspace:*",
    "@hono/node-server": "^2.1.11",
    "@midden/shared": "workspace:*",
    "drizzle-orm": "1.0.0-rc.6",
    "hono": "^4.13.21",
    "pino": "^10.4.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "drizzle-kit": "1.0.0-rc.6",
    "vitest": "^5.1.1"
  }
}
