#!/bin/sh
# Before every commit: lint the staged files (the config covers code, YAML
# and JSON alike) and type-check the workspace, the same checks CI runs.
# Skip once with `git commit --no-verify`.
set -e
if git diff --cached --name-only --diff-filter=ACMR | grep -q .; then
  git diff --cached --name-only --diff-filter=ACMR -z |
    xargs -0 pnpm exec eslint --max-warnings=0 --no-warn-ignored
fi
pnpm typecheck
