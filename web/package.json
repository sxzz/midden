{
  "name": "@midden/web",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "pnpm lint --fix",
    "build:workers": "pnpm build && node ../scripts/prepare-web-assets.mjs",
    "deploy": "pnpm build:workers && wrangler deploy"
  },
  "dependencies": {
    "photoswipe": "^5.4.4",
    "vue": "3.6.0-rc.9",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sxzz/eslint-config": "^8.6.0",
    "@sxzz/prettier-config": "^2.3.3",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/compiler-sfc": "3.6.0-rc.9",
    "eslint": "^10.11.0",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "vue-tsc": "3.3.11",
    "wrangler": "4.143.0"
  },
  "prettier": "@sxzz/prettier-config"
}
