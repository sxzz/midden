{
  "name": "midden",
  "type": "module",
  "private": true,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "pnpm -r --filter @fxembed/atmosphere --filter @midden/web run build",
    "dev": "pnpm --filter @midden/server dev",
    "lint": "eslint --max-warnings=0 .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc -p scripts && pnpm -r --parallel run typecheck",
    "test": "pnpm -r run test"
  },
  "devDependencies": {
    "@sxzz/eslint-config": "^8.9.2",
    "@sxzz/prettier-config": "^2.4.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "6.0.3"
  },
  "prettier": "@sxzz/prettier-config"
}
