{
  "name": "monitor-adapters",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "node scripts/dev-web.mjs",
    "generate": "protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=adapters/x/src/generated --ts_proto_opt=outputServices=grpc-js,env=node,forceLong=string,useExactTypes=false api/adapter/v1/adapter.proto",
    "build": "pnpm --filter @monitor/x-adapter... --recursive run build && pnpm --filter @midden/web build",
    "test": "pnpm --filter @monitor/x-adapter test && pnpm --filter @midden/web test",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "prettier": "3.9.7",
    "ts-proto": "2.7.7",
    "typescript": "6.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  }
}
